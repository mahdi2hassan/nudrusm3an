rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Helpers ---------- */
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function meDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isExpertUser() {
      return isSignedIn() && meDoc().get('isExpert', false) == true;
    }
    // Supervisor / office account approved by admin
    function isStaff() {
      return isSignedIn() && meDoc().accountType in ['supervisor', 'expert_supervisor', 'office'] && meDoc().approved == true;
    }
    function myUpstream() { return meDoc().supervisorId; }
    // Owner's supervisor is me (used for office-level reports)
    function ownerReportsToMe(ownerUid) {
      return get(/databases/$(database)/documents/users/$(ownerUid)).data.supervisorId == request.auth.uid;
    }

    function grantOf(hash) {
      return get(/databases/$(database)/documents/idGrants/$(hash)).data;
    }
    // Synthetic login email for an ID grant: <hash>[-ver]@nid.nudrus.app
    function grantEmail(hash, g) {
      return hash + (g.get('ver', 1) > 1 ? '-' + string(g.ver) : '') + '@nid.nudrus.app';
    }

    /* ---------- Admins ---------- */
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ---------- Users ---------- */
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid || isAdmin()
        || resource.data.get('inviteBy', '') == request.auth.uid
        || resource.data.supervisorId == request.auth.uid
        || ('supervisorId' in meDoc() && meDoc().supervisorId == uid)
        || (resource.data.supervisorId != null
            && get(/databases/$(database)/documents/users/$(resource.data.supervisorId)).data.supervisorId == request.auth.uid)
      );

      // Normal signup, or activation through an ID grant
      allow create: if isOwner(uid)
        && !('featureOverrides' in request.resource.data)
        && request.resource.data.get('isExpert', false) == false
        && request.resource.data.get('verified', false) == false
        && (
          (
            !('supervisorId' in request.resource.data)
            && !('nidHash' in request.resource.data)
            && (
              !('accountType' in request.resource.data)
              || (request.resource.data.accountType in ['student_teacher', 'university_student', 'non_edu_teacher']
                  && request.resource.data.status == 'awaiting_fee')
              || (request.resource.data.accountType in ['supervisor', 'expert_supervisor', 'office']
                  && request.resource.data.approved == false
                  && request.resource.data.status == 'pending_approval')
            )
          )
          || (
            'nidHash' in request.resource.data
            && request.resource.data.status == 'active'
            && request.resource.data.plan == 'granted'
            && exists(/databases/$(database)/documents/idGrants/$(request.resource.data.nidHash))
            && grantOf(request.resource.data.nidHash).claimed == false
            && request.auth.token.email == grantEmail(request.resource.data.nidHash, grantOf(request.resource.data.nidHash))
            && request.resource.data.accountType == grantOf(request.resource.data.nidHash).accountType
            && grantOf(request.resource.data.nidHash).get('supervisorId', null) == request.resource.data.get('supervisorId', null)
            && grantOf(request.resource.data.nidHash).get('expiresMs', null) == request.resource.data.get('grantExpiresMs', null)
          )
        );

      allow update: if isAdmin() || (
        isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['accountType', 'approved', 'supervisorId', 'role', 'isExpert', 'verified', 'nidHash', 'nidLast4', 'grantExpiresMs', 'featureOverrides', 'planExpiresMs', 'paidMs', 'confirmedBy'])
        && (
          request.resource.data.status == resource.data.status
          || !('accountType' in resource.data)
          || (resource.data.status == 'awaiting_fee' && request.resource.data.status == 'pending_payment')
          || (resource.data.status == 'awaiting_fee' && request.resource.data.status == 'active'
              && get(/databases/$(database)/documents/siteSettings/pricing).data[resource.data.accountType].fee == 0)
        )
      );

      // المشرف/الإدارة يقبل عضوًا سجّل برابط دعوته: يربطه بنفسه فقط (حقل supervisorId وحده)
      allow update: if isStaff()
        && resource.data.get('inviteBy', '') == request.auth.uid
        && resource.data.get('supervisorId', '') == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supervisorId'])
        && request.resource.data.supervisorId == request.auth.uid;

      allow delete: if isAdmin();

      match /bookmarks/{id}        { allow read, write: if isOwner(uid); }
      match /following/{targetUid} { allow read, write: if isOwner(uid); }
      match /courseProgress/{courseId} { allow read, write: if isOwner(uid); }
      match /tasks/{id}            { allow read, write: if isOwner(uid); }
    }

    /* ---------- Site settings ---------- */
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- Admin-managed content ---------- */
    match /lessons/{id}              { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /practicalTips/{id}        { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /actionResearchVideos/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /courses/{id}              { allow read: if isSignedIn(); allow write: if isAdmin(); }

    /* ---------- Prep notebooks ---------- */
    match /prepNotebooks/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid &&
        (request.resource.data.get('reviewStatus', 'pending') == 'pending' || isExpertUser());
      allow update: if isSignedIn() && (
        (resource.data.ownerUid == request.auth.uid &&
          request.resource.data.get('reviewStatus', null) == resource.data.get('reviewStatus', null)) ||
        (isExpertUser() && resource.data.ownerUid != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reviewStatus', 'reviewNote', 'reviewedBy', 'reviewedByName']))
      );
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    /* ---------- Private per-owner collections ---------- */
    match /research/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /practicalLog/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /lessonPlans/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /questions/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    /* ---------- Prep rooms ---------- */
    match /prepRooms/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn(); // anyone with the room link can edit / join
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    /* ---------- Points ledger ---------- */
    match /pointsLedger/{id} {
      // أُزيل نظام النقاط — للأدمن قراءة وحذف فقط (أرشيف/تنظيف)
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    /* ---------- Community ---------- */
    match /communityPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );
      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    match /answerVotes/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.voterUid == request.auth.uid &&
        id == request.resource.data.commentId + '_' + request.auth.uid;
      allow delete: if isSignedIn() && resource.data.voterUid == request.auth.uid;
    }

    /* ---------- Quizzes ---------- */
    match /quizzes/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.published == true || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /quizAttempts/{id} {
      allow read: if isSignedIn() && (
        resource.data.userUid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.ownerUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if false;
    }

    /* ---------- Support & reports ---------- */
    match /supportMessages/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /reports/{id} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    /* ---------- Public profiles ---------- */
    match /publicProfiles/{uid} {
      allow read: if isSignedIn() && (
        isOwner(uid) || isAdmin() || resource.data.get('profilePublic', true) == true
      );
      allow create: if isOwner(uid) &&
        request.resource.data.get('isExpert', false) == false &&
        request.resource.data.get('verified', false) == false;
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.get('isExpert', false) == resource.data.get('isExpert', false) &&
        request.resource.data.get('verified', false) == resource.data.get('verified', false)
      );
      allow delete: if isOwner(uid) || isAdmin();
    }

    /* ---------- Ratings ---------- */
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.raterUid == request.auth.uid &&
        request.resource.data.ratedUid != request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.raterUid == request.auth.uid &&
        request.resource.data.raterUid == request.auth.uid &&
        request.resource.data.ratedUid == resource.data.ratedUid;
      allow delete: if isSignedIn() && (resource.data.raterUid == request.auth.uid || isAdmin());
    }

    /* ---------- Payments (Cloud Functions only) ---------- */
    match /paymentAttempts/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    /* ---------- Conversations ---------- */
    match /conversations/{convId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          (
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants is list &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          )
        );
        allow create: if isSignedIn() &&
          (request.resource.data.senderUid == request.auth.uid || isAdmin()) &&
          (
            isAdmin() ||
            (
              get(/databases/$(database)/documents/conversations/$(convId)).data.participants is list &&
              request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            )
          );
        allow update, delete: if false;
      }
    }

    /* ---------- Wallet (750 points = 1 EGP) ---------- */
    match /walletRedemptions/{id} {
      // أُزيل نظام النقاط — للأدمن قراءة وحذف فقط (أرشيف/تنظيف)
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    /* ---------- Referrals ---------- */
    match /referrals/{id} {
      allow read: if isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.newUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.newUid == request.auth.uid &&
        request.resource.data.referrerUid != request.auth.uid &&
        id == request.resource.data.referrerUid + '_' + request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /* ---------- Leaderboard ---------- */
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if isOwner(uid) || isAdmin();
    }

    /* ---------- Weekly challenge ---------- */
    match /challenges/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /challengeEntries/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid &&
        id == request.resource.data.challengeId + '_' + request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /challengeVotes/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.voterUid == request.auth.uid &&
        id == request.resource.data.challengeId + '_' + request.auth.uid &&
        get(/databases/$(database)/documents/challengeEntries/$(request.resource.data.entryId)).data.ownerUid != request.auth.uid;
      allow delete: if isSignedIn() && resource.data.voterUid == request.auth.uid;
    }

    /* ---------- Supervisors / students ---------- */
    match /liveRooms/{id} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || myUpstream() == resource.data.ownerUid
        || ownerReportsToMe(resource.data.ownerUid) || isAdmin());
      allow create: if isStaff() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /assignments/{id} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || myUpstream() == resource.data.ownerUid
        || ownerReportsToMe(resource.data.ownerUid) || isAdmin());
      allow create: if isStaff() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // id = assignmentId_studentUid
    match /submissions/{id} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid || resource.data.ownerUid == request.auth.uid
        || ownerReportsToMe(resource.data.ownerUid) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.ownerUid == myUpstream()
        && !('grade' in request.resource.data) && request.resource.data.status == 'submitted';
      allow update: if isSignedIn() && (
        // supervisor grades
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade', 'feedback', 'status']))
        // student edits before grading
        || (resource.data.studentUid == request.auth.uid && resource.data.status != 'graded'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'fileUrl', 'fileName', 'file', 'status', 'submittedMs', 'submittedAt']))
        || isAdmin());
      allow delete: if isAdmin();

      match /comments/{cid} {
        allow read, create: if isSignedIn() && (
          get(/databases/$(database)/documents/submissions/$(id)).data.studentUid == request.auth.uid
          || get(/databases/$(database)/documents/submissions/$(id)).data.ownerUid == request.auth.uid
          || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /mediaShares/{id} {
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
        || (resource.data.toUid == null && myUpstream() == resource.data.fromUid)
        || ownerReportsToMe(resource.data.fromUid) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid
        && (request.resource.data.toUid == null ? isStaff() : request.resource.data.toUid == myUpstream());
      allow delete: if isSignedIn() && (resource.data.fromUid == request.auth.uid || isAdmin());
    }

    match /supGroups/{ownerUid} {
      allow read: if isSignedIn() && (request.auth.uid == ownerUid || myUpstream() == ownerUid || isAdmin());
      allow write: if isStaff() && request.auth.uid == ownerUid;
    }

    match /broadcasts/{id} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || myUpstream() == resource.data.ownerUid
        || ownerReportsToMe(resource.data.ownerUid) || isAdmin());
      allow create: if isStaff() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // id = roomId_uid
    match /roomAttendance/{id} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || resource.data.uid == request.auth.uid
        || ownerReportsToMe(resource.data.ownerUid) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastJoinMs', 'joins']);
    }

    /* ---------- Coupons: get by code only, no list ---------- */
    match /coupons/{code} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    /* ---------- Audit log ---------- */
    match /auditLog/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    /* ---------- Notifications ---------- */
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.recipientUid is string && request.resource.data.recipientUid != request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }

    /* ---------- ID grants (national-ID login) ---------- */
    // Doc id = truncated SHA-256 of the national ID. get is public, list is admin only.
    match /idGrants/{hash} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        // claim the grant
        || (isSignedIn()
          && resource.data.claimed == false
          && request.resource.data.claimed == true
          && request.resource.data.claimedUid == request.auth.uid
          && request.auth.token.email == grantEmail(hash, resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['claimed', 'claimedUid', 'claimedName', 'claimedMs']))
        // owner links a recovery email
        || (isSignedIn()
          && resource.data.claimed == true
          && resource.data.claimedUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['altEmail']));
    }

    /* ---------- Failed national-ID login counter ---------- */
    match /nidFails/{hash} {
      // العدّاد غير حساس (المفتاح هاش) — القراءة متاحة قبل الدخول لتطبيق القفل المؤقت
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['count', 'lastMs'])
        && request.resource.data.count == 1
        && request.resource.data.lastMs is number
        && request.resource.data.lastMs > request.time.toMillis() - 120000
        && request.resource.data.lastMs < request.time.toMillis() + 120000;
      allow update: if request.resource.data.keys().hasOnly(['count', 'lastMs'])
        && request.resource.data.lastMs is number
        && request.resource.data.lastMs > request.time.toMillis() - 120000
        && request.resource.data.lastMs < request.time.toMillis() + 120000
        && (request.resource.data.count == resource.data.count + 1
            || (request.resource.data.count == 1 && request.time.toMillis() - resource.data.lastMs > 900000));
      allow delete: if isSignedIn();
    }

    /* ---------- ملاحظات المشرف الخاصة على الأعضاء ---------- */
    match /supNotes/{id} {
      allow read, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'memberUid', 'text', 'ms'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow update: if false;
    }

    /* ---------- عدّاد الاستهلاك (تقديري) ---------- */
    match /usageMeter/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.keys().hasOnly(['day', 'reads', 'writes', 'ms'])
        && request.resource.data.reads is number && request.resource.data.reads >= 0 && request.resource.data.reads <= 5000
        && request.resource.data.writes is number && request.resource.data.writes >= 0 && request.resource.data.writes <= 2000;
      allow update: if isSignedIn() && request.resource.data.keys().hasOnly(['day', 'reads', 'writes', 'ms'])
        && request.resource.data.reads - resource.data.reads >= 0 && request.resource.data.reads - resource.data.reads <= 5000
        && request.resource.data.writes - resource.data.writes >= 0 && request.resource.data.writes - resource.data.writes <= 2000;
      allow delete: if isAdmin();
    }

    /* ---------- سجل أخطاء التطبيق ---------- */
    match /errorLogs/{id} {
      allow create: if request.resource.data.keys().hasOnly(['msg', 'src', 'line', 'page', 'ua', 'uid', 'ms'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 320
        && request.resource.data.ms is number;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    /* ---------- Per-user helper tools (schedule, attendance, cards, tasks) ---------- */
    // الأدمن يقرأ فقط (لوحة النشاط)، والكتابة لصاحب الحساب
    match /userTools/{uid} {
      allow write: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
    }

    /* ---------- Shared study decks / docs (get by code, no list) ---------- */
    match /sharedDecks/{id} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /sharedDocs/{id} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid; // مستنداتي (البحث الموحد)
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    /* ---------- Schedule published by a supervisor to their students ---------- */
    match /supSchedules/{uid} {
      allow write: if isOwner(uid) && isStaff();
      allow read: if isSignedIn() && (
        request.auth.uid == uid || isAdmin() || meDoc().get('supervisorId', '') == uid);
    }

    /* ---------- Practicum shares ---------- */
    // student -> supervisor (self-assessments, journals), supervisor -> their teacher (visit reports, plans)
    match /practicumShares/{id} {
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid
        && (request.resource.data.toUid == meDoc().get('supervisorId', '')
            || get(/databases/$(database)/documents/users/$(request.resource.data.toUid)).data.get('supervisorId', '') == request.auth.uid
            || exists(/databases/$(database)/documents/expertLinks/$(request.resource.data.toUid + '_' + request.auth.token.email.lower())));
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && resource.data.fromUid == request.auth.uid;
    }

    /* ---------- Expert links: المشرف الأكاديمي يربط معلمًا خبيرًا (بإيميله) بأعضاء من حساباته ---------- */
    // id = memberUid_expertEmail
    match /expertLinks/{id} {
      allow create, update: if isStaff() && request.resource.data.academicUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.memberUid)).data.get('supervisorId', '') == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.academicUid == request.auth.uid
        || resource.data.expertEmail == request.auth.token.email.lower()
        || isAdmin());
      allow delete: if isSignedIn() && (resource.data.academicUid == request.auth.uid || isAdmin());
    }

    /* ---------- Question bank (expert-reviewed) ---------- */
    match /qbank/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && isExpertUser()
        && resource.data.ownerUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','reviewedBy','reviewedByName','reviewNote']);
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    /* ---------- Surveys ---------- */
    match /surveys/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid
        || myUpstream() == resource.data.ownerUid || isAdmin());
      allow create: if isSignedIn() && isStaff() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /surveyAnswers/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid
        || resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUid == myUpstream();
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* ---------- Daily stats snapshots ---------- */
    match /statsDaily/{id} {
      allow read, write: if isAdmin();
    }

    /* ---------- Targeted broadcasts ---------- */
    match /broadcasts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ---------- Support tickets ---------- */
    match /tickets/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'new';
      allow update: if isSignedIn() && (isAdmin() || (resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies','status','updatedMs'])
        && request.resource.data.status == 'new'));
      allow delete: if isAdmin();
    }

    /* ---------- Daily usage counters (rate limits) ---------- */
    match /usageDaily/{id} {
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.day;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* ---------- Presence (last seen) ---------- */
    match /presence/{uid} {
      allow create, update: if isOwner(uid);
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin()
        || resource.data.get('supervisorId', '') == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.get('supervisorId', '') == request.auth.uid);
    }

    /* ---------- Shared classroom situations ---------- */
    match /situations/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isSignedIn() && isExpertUser() && resource.data.ownerUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedBy','approvedByName']);
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    match /situationVotes/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.sid + '_' + request.auth.uid
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /situationComments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* ---------- Practicum completion certificates ---------- */
    match /pracCerts/{code} {
      allow get: if true; // public verification by code (no list)
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid
        || resource.data.issuedBy == request.auth.uid
        || resource.data.approverUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (isAdmin() || (isStaff()
        && request.resource.data.issuedBy == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.get('supervisorId', '') == request.auth.uid
        && request.resource.data.approverUid == meDoc().get('supervisorId', '')
        && request.resource.data.status == (request.resource.data.approverUid == '' ? 'approved' : 'pending')));
      allow update: if isSignedIn() && (isAdmin() || (isStaff() && resource.data.approverUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedMs','approvedByName'])));
      allow delete: if isSignedIn() && (isAdmin() || resource.data.issuedBy == request.auth.uid);
    }

    /* ---------- Free file storage inside Firestore (chunks) ---------- */
    function fileReadable(d) {
      return d.ownerUid == request.auth.uid || d.public == true || d.shareUp == request.auth.uid
        || (d.shareUp != '' && (meDoc().get('supervisorId', '') == d.shareUp || ownerReportsToMe(d.shareUp)));
    }
    function fileCreatable(d) {
      return d.ownerUid == request.auth.uid
        && (d.public != true || isStaff() || isAdmin())
        && (d.shareUp == '' || d.shareUp == request.auth.uid || d.shareUp == meDoc().get('supervisorId', ''));
    }
    match /fileBlobs/{id} {
      allow get: if isSignedIn() && (fileReadable(resource.data) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && fileCreatable(request.resource.data)
        && request.resource.data.size is int && request.resource.data.size <= 7340032;
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    match /fileChunks/{id} {
      allow get: if isSignedIn() && (fileReadable(resource.data) || isAdmin());
      allow create: if isSignedIn() && fileCreatable(request.resource.data)
        && request.resource.data.data.size() < 950000;
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    /* ---------- Library books ---------- */
    match /books/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isStaff()) && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    /* ---------- Meeting RSVP ---------- */
    match /roomRsvp/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.uid == request.auth.uid
        || ownerReportsToMe(resource.data.ownerUid) || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUid == meDoc().get('supervisorId', '')
        && id == request.resource.data.roomId + '_' + request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    /* ---------- Academic attendance ---------- */
    match /attSites/{id} {
      allow read: if isSignedIn() && (resource.data.scope == 'global' || resource.data.ownerUid == request.auth.uid
        || resource.data.get('supervisorId', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin()
        || (request.resource.data.scope == 'private' && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.supervisorId == meDoc().get('supervisorId', '')
            && request.resource.data.radiusM is number && request.resource.data.radiusM <= 1000));
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }
    match /attSessions/{id} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid
        || meDoc().get('supervisorId', '') == resource.data.ownerUid || ownerReportsToMe(resource.data.ownerUid) || isAdmin());
      allow create: if isStaff() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
    // session check-ins use id = sessionId_uid (one per person); free check-ins use auto ids
    function qrOk(d) {
      return d.sessionId == ''
        || !(get(/databases/$(database)/documents/attSessions/$(d.sessionId)).data.get('qr', false))
        || (d.get('qrCode', '') == get(/databases/$(database)/documents/attCodes/$(d.sessionId)).data.code
            && request.time.toMillis() - get(/databases/$(database)/documents/attCodes/$(d.sessionId)).data.ms < 120000);
    }
    match /attendanceLogs/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid
        || resource.data.supervisorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && attNotOff() && attAllowed() && (
        // self check-in (server-checked: timestamp, one per session, rotating QR when required)
        (request.resource.data.uid == request.auth.uid
          && request.resource.data.get('manual', false) == false
          && request.resource.data.supervisorId == meDoc().get('supervisorId', '')
          && request.resource.data.ts == request.time
          && request.resource.data.ms > request.time.toMillis() - 600000
          && request.resource.data.ms < request.time.toMillis() + 600000
          && (request.resource.data.sessionId == '' || id == request.resource.data.sessionId + '_' + request.auth.uid)
          && qrOk(request.resource.data))
        // manual entry by the member's supervisor, with a written reason
        || (isStaff() && request.resource.data.get('manual', false) == true
          && request.resource.data.supervisorId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.get('supervisorId', '') == request.auth.uid
          && request.resource.data.reason is string && request.resource.data.reason.size() >= 3
          && request.resource.data.ts == request.time
          && (request.resource.data.sessionId == '' || id == request.resource.data.sessionId + '_' + request.resource.data.uid)));
      allow delete: if isAdmin();
    }

    // rotating session code: only the session owner can read/write; rules verify it for check-ins
    function attNotOff() { return !exists(/databases/$(database)/documents/siteSettings/control) || get(/databases/$(database)/documents/siteSettings/control).data.get('attMode', 'delegated') != 'off'; }
    function attAllowed() {
      return !exists(/databases/$(database)/documents/siteSettings/control)
        || get(/databases/$(database)/documents/siteSettings/control).data.get('attMode', 'delegated') == 'all'
        || exists(/databases/$(database)/documents/attAccess/$(request.auth.uid))
        || meDoc().get('supervisorId', '') == ''
        || meDoc().get('accountType', '') == 'office';
    }
    // تفويض الحضور الأكاديمي: المشرف/الإدارة يفعّل لمن تحته فقط (التسلسل مفروض من السيرفر)
    match /attAccess/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || resource.data.by == request.auth.uid || isAdmin()
        || get(/databases/$(database)/documents/users/$(resource.data.by)).data.get('supervisorId', '') == request.auth.uid);
      allow create, update: if isStaff() && request.resource.data.by == request.auth.uid
        && request.resource.data.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.get('supervisorId', '') == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.by == request.auth.uid || isAdmin()
        || get(/databases/$(database)/documents/users/$(resource.data.by)).data.get('supervisorId', '') == request.auth.uid);
    }
    match /attCodes/{sid} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isStaff() && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/attSessions/$(sid)).data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // absence excuses: id = sessionId_uid
    match /attExcuses/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid
        || resource.data.supervisorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.supervisorId == meDoc().get('supervisorId', '')
        && request.resource.data.status == 'pending'
        && id == request.resource.data.sessionId + '_' + request.auth.uid;
      allow update: if isSignedIn() && resource.data.supervisorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedMs']);
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* ---------- الخدمات الجامعية (أوائل) — اشتراك مستقل ---------- */
    function awaelActive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/awaelSubs/$(request.auth.uid))
        && get(/databases/$(database)/documents/awaelSubs/$(request.auth.uid)).data.get('status', '') == 'active'
        && get(/databases/$(database)/documents/awaelSubs/$(request.auth.uid)).data.get('expiresMs', 0) > request.time.toMillis();
    }
    // الاشتراك: القراءة للمالك أو الأدمن، والكتابة للأدمن فقط
    match /awaelSubs/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    // طلب الدفع: طلب واحد لكل مستخدم (id = uid). المستخدم ينشئه، والأدمن يؤكده أو يرفضه
    match /awaelPayReqs/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'amount', 'days', 'ref', 'status', 'createdMs'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.days is number
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      // بعد الرفض يقدر المستخدم يعيد الإرسال (نفس القيود)
      allow update: if isAdmin() || (isOwner(uid) && resource.data.status == 'rejected'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'amount', 'days', 'ref', 'status', 'createdMs'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.days is number
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 60);
      allow delete: if isAdmin();
    }
    // المحتوى: المشترك النشط أو الأدمن يقرأ، والأدمن فقط يكتب
    match /awaelContent/{id} {
      allow read: if isAdmin() || awaelActive();
      allow write: if isAdmin();
    }

    /* ---------- Default deny ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
